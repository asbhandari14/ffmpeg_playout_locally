# ==============================================================================
# FFmpeg Playout Environment Configuration (Common Root Setup)
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

# Application Port (serves both React Frontend and Node.js REST API & Playout)
PORT=5000
MONGO_PORT=27017

# Node Environment
NODE_ENV=production

# Database Configuration
# Local Docker MongoDB: mongodb://mongodb:27017/cloud_playout
# Or external Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/cloud_playout
MONGO_URI=mongodb://mongodb:27017/cloud_playout

# Authentication Secrets (Generate secure random keys in production!)
JWT_ACCESS_SECRET=playout_super_secret_access_jwt_key_2026_!@#
JWT_REFRESH_SECRET=playout_super_secret_refresh_jwt_key_2026_$%^
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AES-256 Server Password Encryption Key (64-char hex string)
SERVER_PASS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Storage Paths (internal container paths)
MEDIA_STORAGE_PATH=/app/server/uploads
OUTPUT_STREAM_DIR=/app/server/streams

# CORS Configuration
CORS_ORIGIN=*
